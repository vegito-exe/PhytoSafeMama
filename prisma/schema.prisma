// PhytoSafeMama — Monograph Database Schema
// Plants with multilingual names, monograph data, and pregnancy safety

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ToxicityLevel {
  SAFE      // 🟢 Safe / Indiqué
  CAUTION   // 🟡 Caution / Prudence
  DANGER    // 🔴 Contraindicated / Contre-indiqué
}

model Plant {
  id                  String        @id @default(uuid())
  nameEn              String        // English name
  nameFr              String        // French name
  nameAr              String        // Arabic name
  nameScientific      String        // Latin binomial
  family              String        // Botanical family
  botanicalDescription String       @default("")
  partUsed            String        @default("")
  chemicalComposition String[]      // Array of compounds
  therapeuticEffects  String[]      // Array of effects
  toxicityLevel       ToxicityLevel
  description         String        // General description for display

  // Pregnancy safety
  pregnancySafetyNote String        @default("")
  isAbortifacient     Boolean       @default(false)
  isUterotonic        Boolean       @default(false)

  symptoms PlantSymptom[]
  warnings ToxicityWarning[]
  sources  Source[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Symptom {
  id     String         @id @default(uuid())
  name   String         @unique
  plants PlantSymptom[]
}

model PlantSymptom {
  plantId   String
  symptomId String
  plant     Plant   @relation(fields: [plantId], references: [id], onDelete: Cascade)
  symptom   Symptom @relation(fields: [symptomId], references: [id], onDelete: Cascade)

  @@id([plantId, symptomId])
}

model ToxicityWarning {
  id          String @id @default(uuid())
  plantId     String
  trimester   Int    // 1, 2, 3 (or 0 for all trimesters)
  warningType String // e.g., "Abortifacient", "Uterotonic", "Fetotoxic"
  details     String
  plant       Plant  @relation(fields: [plantId], references: [id], onDelete: Cascade)
}

model Source {
  id       String @id @default(uuid())
  plantId  String
  refId    Int    // Numeric reference ID from bibliography
  citation String // Full citation text
  plant    Plant  @relation(fields: [plantId], references: [id], onDelete: Cascade)
}
